# .easignore — dans apps/mobile/
# EAS CLI est lancé depuis apps/mobile/ MAIS git root est à Antigravity - Folder/
# EAS uploade tout le repo depuis le git root.
# Ce fichier DOIT exclure tout ce qui n'est pas dans apps/mobile/

# ============================================================
# EXCLURE LES AUTRES APPS DU MONOREPO
# (chemins relatifs depuis la RACINE du git repo)
# ============================================================
apps/web
packages
scripts
tmp
tmp_vercel

# ============================================================
# EXCLURE LES ARTEFACTS ET FICHIERS INUTILES
# ============================================================
node_modules
.turbo
.vercel
.git

# Logs et debug
*.log
*.txt
build_error.log
build_output*.log

# Tableurs et fichiers divers
*.xlsx
*.xls
test.tar

# Fichiers de config non-mobile
turbo.json
vercel.json

# Apps/mobile — fichiers inutiles au build
apps/mobile/node_modules
apps/mobile/.expo
apps/mobile/dist
apps/mobile/build.json
apps/mobile/build-log.txt
apps/mobile/build_log.txt
apps/mobile/eas_logs.txt
apps/mobile/error*.txt
apps/mobile/tsc-errors.txt
apps/mobile/last*.json
apps/mobile/latest_build*.json
apps/mobile/build_success*.json
apps/mobile/eas_help*.txt
apps/mobile/expo-config-err*.txt
apps/mobile/logUrl.txt
apps/mobile/test-resolve.js
apps/mobile/eas-note.txt
apps/mobile/OPTIMIZATION_GUIDE.md
apps/mobile/build_utf8.json
apps/mobile/eas-hooks
